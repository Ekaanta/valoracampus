# Copy to .env and fill in. .env is never committed to Git.

# Accounts: on the first start the app shows a setup page where you create the administrator.
# The administrator creates all other users in the app (gear icon -> Verwaltung / Administration).
# Optional: a long random secret for login tokens (otherwise one is generated and kept in the database)
JWT_SECRET=

# Postgres (docker-compose uses the same password)
POSTGRES_PASSWORD=simon
DATABASE_URL=postgresql+psycopg://simon:simon@localhost:5432/simon

# Persona
ASSISTANT_NAME=SIMON
# de or en: default language; each device can switch in the app (DE/EN button)
LANGUAGE=de
TIMEZONE=Europe/Berlin
DEFAULT_CITY=Berlin
# native voices per language (edge-tts names)
TTS_VOICE_DE=de-DE-ConradNeural
TTS_VOICE_EN=en-GB-RyanNeural

# 1) FreeLLMAPI - paste the unified key from its dashboard (http://localhost:3001 -> Keys)
FREELLMAPI_URL=http://127.0.0.1:3001/v1
FREELLMAPI_KEY=
FREELLMAPI_MODEL=auto

# 1b) Direct free tiers (used on Vercel, where FreeLLMAPI cannot run)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# second Groq model with its own per-minute limit (used when the first is rate-limited; empty = off)
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Cloudflare Workers AI (free 10,000 neurons/day; account ID + API token from dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
# Z.ai (free GLM Flash models; key from z.ai)
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
# OVHcloud AI Endpoints (EU): works without a key, about 2 requests/min per model; empty = off
OVH_MODEL=gpt-oss-120b,gpt-oss-20b

# 2) Ollama - local model on the server (pick by RAM: 8GB -> qwen2.5:3b, 16GB+ -> qwen2.5:7b)
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# 3) Optional paid provider - only ever used after you approve it in the app
PAID_NAME=
PAID_URL=
PAID_KEY=
PAID_MODEL=
PAID_COST_NOTE=

CORS_ORIGINS=http://localhost:5173

# German voice through Fish Audio: free model s2.1-pro-free only (account without card or credits).
# Empty key = standard voice (TTS_VOICE_DE). Any Fish error falls back to the standard voice.
FISH_AUDIO_KEY=
FISH_VOICE_ID=52c4b7e78af343d7aed558478a19e6cb
FISH_VOICE_ID_EN=c700b259c8554960b218a7cb275ee565
